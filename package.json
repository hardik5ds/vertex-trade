{
  "name": "vertex-trade",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app src scripts tests --ext .js,.jsx,.mjs",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "seed": "node --env-file=.env.local scripts/seedMarket.js",
    "migrate": "node --env-file=.env.local scripts/migrate.js",
    "worker": "node --env-file=.env.local scripts/worker.js",
    "check": "npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "services:check": "node --env-file=.env.local scripts/check-services.js",
    "format": "prettier --write app src scripts tests *.js *.json *.md docs/*.md .github/workflows/*.yml",
    "format:check": "prettier --check app src scripts tests *.js *.json *.md docs/*.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.1",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.6",
    "framer-motion": "^10.16.16",
    "jsonwebtoken": "^9.0.2",
    "lightweight-charts": "^5.1.0",
    "mongoose": "^8.24.4",
    "next": "^15.5.26",
    "nodemailer": "^10.0.10",
    "postcss": "^8.5.14",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-redux": "^9.0.4",
    "recharts": "^3.7.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.26",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13 <27"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
