# Copy to .env.local. Never commit the filled file.
# MongoDB Atlas M0 (free) or a local replica set; standalone MongoDB cannot run transactions.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/vertex-trade
# Generate separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CRON_SECRET=
# Exactly the app origin. Change to the HTTPS production URL for deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=singhalhardik044@gmail.com
# Brevo free transactional email. Use the SMTP key, not an account password or API key.
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
EMAIL_FROM=Vertex Trade <YOUR_VERIFIED_SENDER@example.com>
